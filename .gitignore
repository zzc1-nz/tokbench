# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# tokbench run artifacts
# ---------------------------------------------------------------------------
# Run directories are *data*, not source. A single 2,250-cell run is ~8 MB of
# append-only JSONL, and regenerating it is one command (`tokbench run`), so the
# repo ships the rendered report + figures instead of the raw call log.
reports/*/
!reports/.gitkeep

# ---------------------------------------------------------------------------
# Sandbox / editor noise
# ---------------------------------------------------------------------------
# This project was developed inside a confined Windows sandbox where pytest's
# own temp fixtures are unusable; the suite provisions workspace-local scratch
# directories instead. Those are artefacts, never source.
.pytemp/
.pytmp/
.pytest_tmp/
pytest-cache-files-*/
tests/_*_scratch/
tests/.tmp_render*/
tests/.ptmp*/
tests/.scratch/
.app.py.bak

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
